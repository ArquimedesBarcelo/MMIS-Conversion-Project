//BCHJOB   JOB(BFRTPROC1) JOBD(*LIBL/MCMGR) JOBQ(*LIBL/HBATCH) +
             LOG(*JOBD *JOBD *JOBD) LOGCLPGM(*YES)

/* * * * * * * * * * * * * * * * * * * * * */
/*   THIS JOB WILL PROCESS FREIGHT INFO.   */
/*   THE PARM OF "1" INDICATES THAT IT     */
/*   WILL LOOK FOR THE DAILY FREIGHT FILES.*/
/* * * * * * * * * * * * * * * * * * * * * */

             CALL PGM(TFRTPROC)
1

  STRDBRDR   FILE(QJOBSRC) MBR(BXFRTSTT) JOBQ(HBATCH) RDR(BXFRTSTT)
             CALL PGM(BFRTERR)

/***** 06OCT1993 COMMENTED OUT THE FOLLOWING STRDBRDR STMT - DAVE PLUM */
/*****    - BCSASTRN NO LONGER NEEDS TO BE STARTED AS PART OF THIS JOB */
/*STRDBRDR   FILE(QJOBSRC) MBR(BCSASTRN) JOBQ(HBATCH) RDR(BCSASTRN)*/

//ENDBCHJOB
