             PGM        /* Create CSIS/MMIS Error Log and send to Akron */

             DCL        VAR(&QRYSLT) TYPE(*CHAR) LEN(100)
             DCL        VAR(&NEWDATE) TYPE(*CHAR) LEN(6)
             DCL        VAR(&YYMMDD) TYPE(*CHAR) LEN(6)
             DCL        VAR(&SYSTEM) TYPE(*CHAR) LEN(10)
             DCL        VAR(&PRINTTEXT) TYPE(*CHAR) LEN(30)
             DCL        VAR(&ERRNO) TYPE(*DEC) LEN(10 0)
 BEGIN:

 /*  CHANGE THE JOB TO PRINT THE SYSTEM NAME ON THE REPORT         */

             RTVNETA    SYSNAME(&SYSTEM)

             CHGVAR     VAR(&PRINTTEXT) VALUE('CSIS/MMIS Error Log: +
                          ' *CAT &SYSTEM)

             CHGJOB     PRTTXT(&PRINTTEXT)

 /*  OVERRIDE THE PRINT FILE TO THE CORRECT PAPER SIZE             */

             OVRPRTF    FILE(QPQUPRFIL) PAGESIZE(66 195) LPI(6) +
                          CPI(15) OVRFLW(60) OUTQ(PD01) +
                          USRDTA(ERRORRPT)
             MONMSG     MSGID(CPF0000)

 /*  GET YESTERDAY'S DATE                                          */

             ADDDAT     DAYS(-1) TOVAR(&NEWDATE)
             MONMSG     MSGID(CPF0000)

 /*  CONVERT THE DATE TO YYMMDD FORMAT                               */
 /*      FOR MM/DD/YY LOCATIONS:                                     */

             CVTDAT     DATE(&NEWDATE) TOVAR(&YYMMDD) FROMFMT(*MDY) +
                          TOFMT(*YMD) TOSEP(*NONE)

 /*      FOR DD/MM/YY LOCATIONS:                                     */
 /*                                                                  */
 /*          CVTDAT     DATE(&NEWDATE) TOVAR(&YYMMDD) FROMFMT(*DMY) +*/
 /*                       TOFMT(*YMD) TOSEP(*NONE)                   */

 /*  RETRIEVE YESTERDAY'S ERROR RECORDS                            */

             CPYF       FROMFILE(MCFPERRORS) +
                          TOFILE(QTEMP/MCFPERRORS) MBROPT(*REPLACE) +
                          CRTFILE(*YES) INCCHAR(MCDATE 1 *EQ &YYMMDD)
             MONMSG     MSGID(CPF0000)

 /* CHECK NUMBER OF ERRORS RETRIEVED */
             RTVMBRD    FILE(QTEMP/MCFPERRORS) NBRCURRCD(&ERRNO)
             MONMSG     MSGID(CPF0000)
             IF (&ERRNO *EQ 0) THEN(GOTO CMDLBL(FINI))

 /*  RUN QUERY AGAINS QTEMP FILE                                   */

             OVRDBF     FILE(MCFPERRORS) TOFILE(QTEMP/MCFPERRORS)
             MONMSG     MSGID(CPF0000)

 /*  GENERATE THE REPORT                                           */

             RUNQRY     QRY(ERRLISTDLY)
             MONMSG     MSGID(CPF0000)

 /*  SEND THE GENERATED SPOOL FILE TO AKRON60                      */

             SNDNETSPLF FILE(QPQUPRFIL) TOUSRID((PRINTIT AKRON60)) +
                          SPLNBR(*LAST) DTAFMT(*ALLDATA)
             MONMSG     MSGID(CPF0000)

 /*  CLEAN UP OLD ERROR MSGS MORE THAN 1 YEAR OLD                  */

             CALL       PGM(TERRCLNUP)

 FINI:

             DLTF       FILE(QTEMP/MCFPERRORS)
             MONMSG     MSGID(CPF0000)
             ENDPGM
