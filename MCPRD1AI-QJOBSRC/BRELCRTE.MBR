//BCHJOB  JOB(RELCRTE) JOBD(*libl/MCMGR) JOBQ(*JOBD) LOG(*JOBD +
             *JOBD *MSG) LOGCLPGM(*YES)
             CHGDTAARA  DTAARA(*LDA (258 1)) VALUE('1')
   /********************************************************/
   /*** NOW RENAME GENERATIONS OF THE RELFILE FILE       ***/
   /*** AND BUILD NEW ONE SO IT IS READY FOR NEXT        ***/
   /*** TRANSMISSION.                                    ***/
   /********************************************************/
   CALL MCXCRTFIL PARM('*CURLIB' 'RELFILE4' '096' '1000' '1000' +
                 '30')
   CALL MCXCRTFIL PARM('*CURLIB' 'RELFILE3' '096' '1000' '1000' +
                 '30')
   CALL MCXCRTFIL PARM('*CURLIB' 'RELFILE2' '096' '1000' '1000' +
                 '30')
   CALL MCXCRTFIL PARM('*CURLIB' 'RELFILE' '096' '1000' '1000' +
                 '30')
   CALL MCDLT    PARM('RELFILE5')
   CALL MCXRENAM PARM('RELFILE4' 'RELFILE5')
   CALL MCXRENAM PARM('RELFILE3' 'RELFILE4')
   CALL MCXRENAM PARM('RELFILE2' 'RELFILE3')
   CALL MCXRENAM PARM('RELFILE' 'RELFILE2')
   CALL       PGM(MCXCRTFIL) PARM('*CURLIB' 'RELFILE' +
                 '096' '1000' '1000' '30')
   CALL MCDLT    PARM('RELRPTFL')
   CALL       PGM(MCXCRTFIL) PARM('*CURLIB' 'RELRPTFL' +
                 '133' '1000' '1000' '30')
   CALL MCDLT    PARM('RELERRFL')
   CALL       PGM(MCXCRTFIL) PARM('*CURLIB' 'RELERRFL' +
                 '133' '1000' '1000' '30')
CALL FOTRELBATC
ALL
***********

/* PRINT THE SHIPPING RELEASE REPORT                              */
/* OVERRIDE TO THE DESIRED REPORT FILE                            */
                 OVRDBF     FILE(MCFPRPT) TOFILE(*LIBL/RELRPTFL)
/* SPOOL TYPE: SHOULD ALWAYS BE 'N'                               */
/*               CHGDTAARA  DTAARA(*LDA (291 1)) VALUE('N')       */
/* PRINT NUM                                                      */
                 CHGDTAARA  DTAARA(*LDA (292 3)) VALUE('015')
/* PAPER WIDTH: 'Y' IS COMPRESSED                                 */
                 CHGDTAARA  DTAARA(*LDA (295 1)) VALUE('Y')
/* NUMBER OF COPIES                                               */
                 CHGDTAARA  DTAARA(*LDA (296 2)) VALUE('01')
/* RANGE OF DATES. 'Y' = BRING UP SCRN , 'N' = NO SCRN            */
                 CHGDTAARA  DTAARA(*LDA (298 1)) VALUE('N')
                 CALL TPRTRPT
/* PRINT THE SHIPPING RELEASE ERROR REPORT                        */
/* OVERRIDE TO THE DESIRED REPORT FILE                            */
                 OVRDBF     FILE(MCFPRPT) TOFILE(*LIBL/RELERRFL)
/* SPOOL TYPE: SHOULD ALWAYS BE 'N'                               */
/*               CHGDTAARA  DTAARA(*LDA (291 1)) VALUE('N')       */
/* PRINT NUM                                                      */
                 CHGDTAARA  DTAARA(*LDA (292 3)) VALUE('015')
/* PAPER WIDTH: 'Y' IS COMPRESSED                                 */
                 CHGDTAARA  DTAARA(*LDA (295 1)) VALUE('Y')
/* NUMBER OF COPIES                                               */
                 CHGDTAARA  DTAARA(*LDA (296 2)) VALUE('01')
/* RANGE OF DATES. 'Y' = BRING UP SCRN , 'N' = NO SCRN            */
                 CHGDTAARA  DTAARA(*LDA (298 1)) VALUE('N')
                 CALL TPRTRPT

             DLTF       FILE(RLACTIVE)
//ENDBCHJOB
