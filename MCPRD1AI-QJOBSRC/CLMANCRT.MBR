             PGM /*CLMANCRT*/
             DCL        VAR(&S) TYPE(*CHAR) LEN(2)
   /**************************************************************/
   /***  CHECK FOR EXISTENCE OF EACH GENERATION.  IF NOT       ***/
   /***  THERE, CREATE IT.  NOTE!  *CURLIB IS USED FOR         ***/
   /***  ALL FILE CREATES, DELETES, RENAMES, AND OVRDBFS!      ***/
   /**************************************************************/
   CALL CCRTFILE PARM('*CURLIB' 'MANWKFL5' '5' '1000' '1000' '30' &S)
   CALL CCRTFILE PARM('*CURLIB' 'MANWKFL4' '5' '1000' '1000' '30' &S)
   CALL CCRTFILE PARM('*CURLIB' 'MANWKFL3' '5' '1000' '1000' '30' &S)
   CALL CCRTFILE PARM('*CURLIB' 'MANWKFL2' '5' '1000' '1000' '30' &S)
   CALL CCRTFILE PARM('*CURLIB' 'MANWKFL1' '5' '1000' '1000' '30' &S)
   CALL CCRTFILE PARM('*CURLIB' 'MANAKFL9' '80' '1000' '1000' '30' &S)
   CALL CCRTFILE PARM('*CURLIB' 'MANAKFL8' '80' '1000' '1000' '30' &S)
   CALL CCRTFILE PARM('*CURLIB' 'MANAKFL7' '80' '1000' '1000' '30' &S)
   CALL CCRTFILE PARM('*CURLIB' 'MANAKFL6' '80' '1000' '1000' '30' &S)
   CALL CCRTFILE PARM('*CURLIB' 'MANAKFL5' '80' '1000' '1000' '30' &S)
   CALL CCRTFILE PARM('*CURLIB' 'MANAKFL4' '80' '1000' '1000' '30' &S)
   CALL CCRTFILE PARM('*CURLIB' 'MANAKFL3' '80' '1000' '1000' '30' &S)
   CALL CCRTFILE PARM('*CURLIB' 'MANAKFL2' '80' '1000' '1000' '30' &S)
   CALL CCRTFILE PARM('*CURLIB' 'MANAKFL1' '80' '1000' '1000' '30' &S)
 EOJ:        ENDPGM
