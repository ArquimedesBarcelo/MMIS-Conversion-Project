             PGM

             /***************************************************/
             /*** 06/11/1999                                  ***/
             /*** THIS PROGRAM EXPANDS THE MTAX DATASET       ***/
             /*** (MCFPCS3700) AND ALSO INSTALLS THE          ***/
             /*** CHANGED PROGRAMS.                           ***/
             /***                                             ***/
             /*** UPDATE FOR K.01 VERSION OF CSIS/MMIS.       ***/
             /***************************************************/

             DCL        VAR(&LIB)    TYPE(*CHAR) LEN(5) VALUE('MCPRD')
             DCL        VAR(&LIBN) TYPE(*DEC) LEN(1) VALUE(1)
             DCL        VAR(&LIBC) TYPE(*CHAR) LEN(1)
             DCL        VAR(&CURLIB) TYPE(*CHAR) LEN(6)
             DCL        VAR(&NBRCURRCD) TYPE(*DEC) LEN(10 0)

             CHGJOB     LOG(4 0 *SECLVL) LOGCLPGM(*YES)
LOOP:
             CHGVAR     VAR(&LIBC) VALUE(&LIBN)
             CHGVAR     VAR(&CURLIB) VALUE(&LIB *CAT &LIBC)

/*** Check to see if data library MCPRD* exists.  If it does not exist, ***/
/*** and MCPRD9 was just checked then end; otherwise, go back to LOOP.  ***/
             CHKOBJ     OBJ(QSYS/&CURLIB) OBJTYPE(*LIB)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                 IF COND(&LIBN *EQ 9) THEN(GOTO CMDLBL(ENDLOOP))
                 CHGVAR VAR(&LIBN) VALUE(&LIBN + 1)
                 GOTO CMDLBL(LOOP)
             ENDDO

             CHGCURLIB  CURLIB(&CURLIB)
             SNDMSG     MSG('PROGRAM CLTAXCHG IS NOW UPDATING  +
                          CSIS/MMIS DATA LIBRARY - ' *CAT &CURLIB) +
                          TOUSR(*SYSOPR)

             CHKOBJ     OBJ(*CURLIB/MCFPCS3700) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(GOTO CMDLBL(EOJ))

             CHGPF      FILE(*CURLIB/MCFPCS3700) +
                          SRCFILE(MCPRD/QDDSSRCDB) LANGID(ENU)

             RUNSQL     REQUEST('UPDATE MCFPCS3700 SET TAXPCT1 = +
                          (TAXPCT1 * 100), TAXPCT2 = (TAXPCT2 * +
                          100), TAXPCT3 = (TAXPCT3 * 100), TAXPCT4 +
                          = (TAXPCT4 * 100)') /* Multiply tax +
                          percents by 100. */

/*** Increment the library name by 1, and go back to the beginning   ***/
/*** of the program.                                                 ***/
             SNDMSG     MSG('PROGRAM CLTAXCHG COMPLETED UPDATING  +
                          CSIS/MMIS DATA LIBRARY - ' *CAT &CURLIB) +
                          TOUSR(*SYSOPR)
             IF COND(&LIBN *EQ 9) THEN(GOTO CMDLBL(ENDLOOP))
             CHGVAR     VAR(&LIBN) VALUE(&LIBN + 1)
             GOTO CMDLBL(LOOP)

ENDLOOP:
             SNDMSG     MSG('CLTAXCHG HAS COMPLETED FILE UPDATES.  +
                          NOW RESTORING PROGRAMS') TOUSR(*SYSOPR)

/*** Move old programs to MCBCK.                                     ***/
             MOVOBJ     OBJ(MCPRD/SADDPITM) OBJTYPE(*PGM) TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/SCALCBGT) OBJTYPE(*PGM) TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/SEDIABST) OBJTYPE(*PGM) TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/SFRTAPPLY) OBJTYPE(*PGM) TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/SMODIACC) OBJTYPE(*PGM) TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/SMODSITM) OBJTYPE(*PGM) TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/SMREQINQ) OBJTYPE(*PGM) TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/SQTPOS) OBJTYPE(*PGM) TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/SRELEASE) OBJTYPE(*PGM) TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/STAXRPT) OBJTYPE(*PGM) TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TEDIABST) OBJTYPE(*PGM) TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TINVGEN) OBJTYPE(*PGM) TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TINVOICE) OBJTYPE(*PGM) TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TMANCRTE) OBJTYPE(*PGM) TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TMANTOR) OBJTYPE(*PGM) TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TPLTMAST) OBJTYPE(*PGM) TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/TTAXENTY) OBJTYPE(*PGM) TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/ZTAXENTY) OBJTYPE(*FILE) TOLIB(MCBCK)
             MOVOBJ     OBJ(MCPRD/ZINVOICE) OBJTYPE(*FILE) TOLIB(MCBCK)

/*** Restore changed programs to MCPRD.                              ***/
             RSTOBJ     OBJ(SADDPITM SCALCBGT SEDIABST SFRTAPPLY +
                          SMODIACC SMODSITM SMREQINQ SQTPOS +
                          SRELEASE STAXRPT TEDIABST TINVGEN +
                          TINVOICE TMANCRTE TMANTOR TPLTMAST +
                          TTAXENTY ZTAXENTY ZINVOICE) SAVLIB(MCTST) +
                          DEV(*SAVF) SAVF(MCBCK/A257947) RSTLIB(MCPRD)

             SNDMSG     MSG('CLTAXCHG HAS COMPLETED RESTORING +
                          PROGRAMS.') TOUSR(*SYSOPR)

 EOJ:        ENDPGM
