             PGM        /* CREATE MACOS QUERY REPORTS */

             DCL        VAR(&SYSTEM) TYPE(*CHAR) LEN(10)
             DCL        VAR(&PRINTTEXT) TYPE(*CHAR) LEN(36)
 START:

 /*  CHANGE THE JOB TO PRINT THE SYSTEM NAME ON THE REPORT         */
             RTVNETA    SYSNAME(&SYSTEM)
             CHGVAR     VAR(&PRINTTEXT) VALUE('Inv Charges (MACOS): +
                          ' *CAT &SYSTEM)
             CHGJOB     PRTTXT(&PRINTTEXT)

 /*  OVERRIDE THE PRINT FILE TO THE CORRECT PAPER SIZE             */
             OVRPRTF    FILE(QPQUPRFIL) PAGESIZE(68 195) LPI(8) +
                          CPI(15) OVRFLW(60) OUTQ(PD01) SAVE(*YES) +
                          USRDTA(MACOS)
             MONMSG     MSGID(CPF0000)

 /*  DELETE THE DATASETS WHICH THE QUERY PROGRAMS WILL CREATE */
             CALL       PGM(MCDLT) PARM('MACOSMTLS')
             CALL       PGM(MCDLT) PARM('MACOSITEMS')
             CALL       PGM(MCDLT) PARM('MACOSINVS')
             CALL       PGM(MCDLT) PARM('MACOSPOHD')
             CALL       PGM(MCDLT) PARM('MACOSVNDR')
             CALL       PGM(MCDLT) PARM('MACOSPOPD')
             CALL       PGM(MCDLT) PARM('MACOSINPD')
             CALL       PGM(MCDLT) PARM('MACOSCOMP')
             CALL       PGM(MCDLT) PARM('MACOSTOTL')
             CALL       PGM(MCDLT) PARM('MACOSSUMX')

 /*  RUN THE QUERY PROGRAMS                                        */
             RUNQRY     QRY(MCPRD/MACOSQ01)
             MONMSG     MSGID(CPF0000)
             RUNQRY     QRY(MCPRD/MACOSQ02)
             MONMSG     MSGID(CPF0000)
             RUNQRY     QRY(MCPRD/MACOSQ03)
             MONMSG     MSGID(CPF0000)
             RUNQRY     QRY(MCPRD/MACOSQ04)
             MONMSG     MSGID(CPF0000)
             RUNQRY     QRY(MCPRD/MACOSQ05)
             MONMSG     MSGID(CPF0000)
             RUNQRY     QRY(MCPRD/MACOSQ06P)
             MONMSG     MSGID(CPF0000)
             RUNQRY     QRY(MCPRD/MACOSQ06I)
             MONMSG     MSGID(CPF0000)
             RUNQRY     QRY(MCPRD/MACOSQ07P)
             MONMSG     MSGID(CPF0000)
             RUNQRY     QRY(MCPRD/MACOSQ07I)
             MONMSG     MSGID(CPF0000)
             RUNQRY     QRY(MCPRD/MACOSQ08)
             MONMSG     MSGID(CPF0000)
             RUNQRY     QRY(MCPRD/MACOSQ09) /* CREATE DETAIL REPORT */
             MONMSG     MSGID(CPF0000)
             RUNQRY     QRY(MCPRD/MACOSQ10)
             MONMSG     MSGID(CPF0000)
             RUNQRY     QRY(MCPRD/MACOSQ11) /* CREATE SUMMARY REPORT */
             MONMSG     MSGID(CPF0000)

 END:
             ENDPGM
