             PGM
             RMVM   FILE(FRTDATAFL)  MBR(TISDATA10)
             MONMSG MSGID(CPF0000)

             RNMM   FILE(FRTDATAFL)  MBR(TISDATA9)   NEWMBR(TISDATA10)
             MONMSG MSGID(CPF0000)
             RNMM   FILE(FRTDATAFL)  MBR(TISDATA8)   NEWMBR(TISDATA9)
             MONMSG MSGID(CPF0000)
             RNMM   FILE(FRTDATAFL)  MBR(TISDATA7)   NEWMBR(TISDATA8)
             MONMSG MSGID(CPF0000)
             RNMM   FILE(FRTDATAFL)  MBR(TISDATA6)   NEWMBR(TISDATA7)
             MONMSG MSGID(CPF0000)
             RNMM   FILE(FRTDATAFL)  MBR(TISDATA5)   NEWMBR(TISDATA6)
             MONMSG MSGID(CPF0000)
             RNMM   FILE(FRTDATAFL)  MBR(TISDATA4)   NEWMBR(TISDATA5)
             MONMSG MSGID(CPF0000)
             RNMM   FILE(FRTDATAFL)  MBR(TISDATA3)   NEWMBR(TISDATA4)
             MONMSG MSGID(CPF0000)
             RNMM   FILE(FRTDATAFL)  MBR(TISDATA2)   NEWMBR(TISDATA3)
             MONMSG MSGID(CPF0000)
             RNMM   FILE(FRTDATAFL)  MBR(TISDATA1)   NEWMBR(TISDATA2)
             MONMSG MSGID(CPF0000)
             CPYF       FROMFILE(FRTDATAFL) TOFILE(FRTDATAFL) +
                          FROMMBR(TISDATA) TOMBR(TISDATA1) +
                          MBROPT(*REPLACE) CRTFILE(*YES)

             CALL PGM(TFRTWRKPFM)

             CLRPFM     FILE(FRTDATAFL) MBR(TISDATA)

             STRDBRDR   FILE(MCPRD1/QJOBSRC) MBR(BFRTPROC1) +
                          JOBQ(HBATCH)

             ENDPGM
