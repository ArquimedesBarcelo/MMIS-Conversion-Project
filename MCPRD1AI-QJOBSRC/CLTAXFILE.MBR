             CLRPFM     FILE(MCPRD1/TAXRPT)

/* RUN FOR XXXXXX TO XXXXXX */
             CHGVAR     VAR(&DATALINE) VALUE('2000040120000430')
             CALL       PGM(TTAXFILE) PARM(&DATALINE)
             ENDPGM
