   PGM
   /**************************************************************/
   /*** THIS JOB RUNS A RECOVER AGAINST ALL 9 AKPOFILES TO     ***/
   /*** RECOVER ANY LOST DATA                                  ***/
   /**************************************************************/
   CHGDTAARA  DTAARA(*LDA (285 1)) VALUE('N')
   OVRDBF FILE(AKPOFILE) TOFILE(*CURLIB/AKPOFIL9)
   CALL TLOADPO
   OVRDBF FILE(AKPOFILE) TOFILE(*CURLIB/AKPOFIL8)
   CALL TLOADPO
   OVRDBF FILE(AKPOFILE) TOFILE(*CURLIB/AKPOFIL7)
   CALL TLOADPO
   OVRDBF FILE(AKPOFILE) TOFILE(*CURLIB/AKPOFIL6)
   CALL TLOADPO
   OVRDBF FILE(AKPOFILE) TOFILE(*CURLIB/AKPOFIL5)
   CALL TLOADPO
   OVRDBF FILE(AKPOFILE) TOFILE(*CURLIB/AKPOFIL4)
   CALL TLOADPO
   OVRDBF FILE(AKPOFILE) TOFILE(*CURLIB/AKPOFIL3)
   CALL TLOADPO
   OVRDBF FILE(AKPOFILE) TOFILE(*CURLIB/AKPOFIL2)
   CALL TLOADPO
    ENDPGM
