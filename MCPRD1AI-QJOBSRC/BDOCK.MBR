             PGM
             DCL        VAR(&INFILE) TYPE(*CHAR) LEN(30)
ALLOCATIT:
             ALCOBJ     OBJ((MCPRDB/DOCKFILE *FILE *EXCL *FIRST)) +
                          WAIT(5)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                DLYJOB     DLY(30)
                GOTO ALLOCATIT
             ENDDO

             CALL PGM(QMRSWTR) PARM(&INFILE)
             DLCOBJ     OBJ((MCPRDB/DOCKFILE *FILE *EXCL *FIRST))

             SBMJOB     CMD(CALL PGM(MCPRDB/BXLOADDK)) JOB(BXLOADDK) +
                          JOBD(MCMGR) JOBQ(HLBATCH) PRTDEV(*JOBD) +
                          OUTQ(*JOBD) USER(*JOBD) PRTTXT(*JOBD) +
                          CURLIB(*USRPRF) INLLIBL(*JOBD)
             ENDPGM
