//BCHJOB  JOB(BRPTAR8) JOBD(*libl/MCMGR) JOBQ(*JOBD) LOG(*JOBD +
             *JOBD *MSG) LOGCLPGM(*YES)
             OVRDBF     FILE(MCFPRPT) TOFILE(*LIBL/PAYRPTFL)
             /*** PRINT NUM ***/
             CHGDTAARA  DTAARA(*LDA (292 3)) VALUE('099')
             /*** PAPER WIDTH. 'Y' = 132 (COMPRESSED), 'N' = 80 ***/
             CHGDTAARA  DTAARA(*LDA (295 1)) VALUE('N')
             /*** NUMBER OF COPIES ***/
             CHGDTAARA  DTAARA(*LDA (296 2)) VALUE('01')
             /*** RANGE OF DATES. 'Y' = BRING UP SCRN 'N' = NO SCRN **/
             CHGDTAARA  DTAARA(*LDA (298 1)) VALUE('N')
             CALL TPRTRPT
//ENDBCHJOB
